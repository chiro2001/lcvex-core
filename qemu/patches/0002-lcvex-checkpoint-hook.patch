diff --git a/include/exec/lcvex-difftest.h b/include/exec/lcvex-difftest.h
new file mode 100644
index 0000000..6480923
--- /dev/null
+++ b/include/exec/lcvex-difftest.h
@@ -0,0 +1,131 @@
+/*
+ * LCVEX difftest 精确 step hook 的通用接口。
+ *
+ * LCVEX 项目用固定版本 QEMU 做逐指令差分：普通指令可以用 TCG 插件
+ * before-instruction 回调采样状态，但同步异常（SVC/UDEF/Abort 等）没有
+ * 插件级精确退休事件。本 hook 在 QEMU fork 内部补上两件事：
+ *
+ *   1. LCVEX_DIFFTEST_STEP=1 时强制单指令 TB（CF_NO_GOTO_TB | 1），
+ *      保证每条 guest 指令都是一个执行边界（见 accel/tcg/cpu-exec-common.c）。
+ *   2. 异常入口（arm_cpu_do_interrupt）时记录同步异常的 ESR.EC，插件在
+ *      discon 回调里通过 qemu_lcvex_difftest_take_exception() 取用，
+ *      从而把“异常未退休 + 异常入口 PC discontinuity”精确上报。
+ *
+ * 仅用于 LCVEX 差分测试；非测试运行不受影响（默认不激活）。
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef QEMU_LCVEX_DIFFTEST_H
+#define QEMU_LCVEX_DIFFTEST_H
+
+#include "hw/core/cpu.h"
+
+#define LCVEX_SYS_STATE_VERSION 2u
+#define LCVEX_TIMER_STATE_VERSION 1u
+#define LCVEX_GIC_STATE_VERSION 1u
+#define LCVEX_GIC_IRQ_COUNT 96u
+
+/* QEMU -> LCVEX checkpoint sidecar。字段只选当前 RTL 已有或 Linux
+ * 恢复必需的架构状态，避免依赖 QEMU 私有 VMState 编码。 */
+struct __attribute__((packed)) lcvex_sys_state {
+    char magic[8];             /* "LCVXSYS2" */
+    uint32_t version;
+    uint32_t size;
+    uint64_t x[31];
+    uint64_t pc;
+    uint64_t next_pc;
+    uint64_t sp_el0;
+    uint64_t sp_el1;
+    uint64_t pstate;
+    uint64_t daif;
+    uint64_t elr_el1;
+    uint64_t spsr_el1;
+    uint64_t vbar_el1;
+    uint64_t sctlr_el1;
+    uint64_t tcr_el1;
+    uint64_t ttbr0_el1;
+    uint64_t ttbr1_el1;
+    uint64_t mair_el1;
+    uint64_t esr_el1;
+    uint64_t far_el1;
+    uint64_t par_el1;
+    uint64_t cpacr_el1;
+    uint64_t mdscr_el1;
+    uint64_t cntkctl_el1;
+    uint64_t tpidr_el0;
+    uint64_t tpidrro_el0;
+    uint64_t tpidr_el1;
+    uint64_t pir_el1;
+    uint64_t pire0_el1;
+    uint32_t nzcv;
+    uint8_t el;
+    uint8_t sp_sel;
+    uint8_t reserved[6];
+    /* v2：SVE/SME 探测控制寄存器与缓存选择器。SMPRI_EL1 在 QEMU
+     * 11.1（SMIDR_EL1.SMPS=0）为 RES0，无需保存。 */
+    uint64_t zcr_el1;
+    uint64_t smcr_el1;
+    uint64_t csselr_el1;
+};
+
+/* Generic Timer checkpoint sidecar。计数器采用 QEMU icount 的虚拟计数，
+ * ctl 保留 ENABLE/IMASK/ISTATUS 三个位；恢复到 DUT 时 ISTATUS 由
+ * cntpct、CVAL 和 CTL 重新组合，避免保存一个过期的派生值。 */
+struct __attribute__((packed)) lcvex_timer_state {
+    char magic[8];             /* "LCVXTMR1" */
+    uint32_t version;
+    uint32_t size;
+    uint64_t cntpct;
+    uint64_t cntfrq;
+    uint64_t cntvoff_el2;
+    uint64_t cntpoff_el2;
+    uint64_t cntp_cval;
+    uint64_t cntp_ctl;
+    uint64_t cntv_cval;
+    uint64_t cntv_ctl;
+};
+
+struct __attribute__((packed)) lcvex_gic_irq_state {
+    uint8_t enabled;
+    uint8_t pending;
+    uint8_t active;
+    uint8_t level;
+    uint8_t edge;
+    uint8_t group;
+};
+
+/* 当前 RTL 的单核 GICv2 摘要。QEMU virt 的 GIC 实例可有 128 个 IRQ，
+ * 但 RTL 只建模前 96 个；保存时若 96 以外仍有 live enable/pending/active
+ * 状态则拒绝发布，不能静默丢失中断。 */
+struct __attribute__((packed)) lcvex_gic_state {
+    char magic[8];             /* "LCVXGIC1" */
+    uint32_t version;
+    uint32_t size;
+    uint32_t num_irq;
+    uint32_t reserved;
+    uint32_t ctlr;
+    uint32_t cpu_ctlr;
+    uint16_t priority_mask;
+    uint16_t running_priority;
+    uint16_t current_pending;
+    uint8_t bpr;
+    uint8_t abpr;
+    uint8_t reserved2[2];
+    struct lcvex_gic_irq_state irq[LCVEX_GIC_IRQ_COUNT];
+    uint8_t priority[LCVEX_GIC_IRQ_COUNT];
+    uint8_t sgi_pending[16];
+    uint16_t reserved3;
+};
+
+/*
+ * 在 arm_cpu_do_interrupt() 异常入口处记录本次异常信息。
+ * 同步异常记录 ESR.EC；IRQ/FIQ 等异步事件记录为 async。
+ */
+void qemu_lcvex_difftest_note_exception(CPUState *cs);
+
+/* QEMU -incoming 设备状态不包含 QEMU_CLOCK_VIRTUAL 的当前基准；联合
+ * 恢复时由插件在第一条指令前读取 timer sidecar，设置一个仅限 difftest
+ * 的计数修正。普通运行该 offset 始终为 0。 */
+uint64_t qemu_lcvex_difftest_timer_offset(void);
+
+#endif /* QEMU_LCVEX_DIFFTEST_H */
