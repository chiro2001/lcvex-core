diff --git a/target/arm/tcg/op_helper.c b/target/arm/tcg/op_helper.c
index c4433be..fea1179 100644
--- a/target/arm/tcg/op_helper.c
+++ b/target/arm/tcg/op_helper.c
@@ -26,6 +26,8 @@
 #include "accel/tcg/cpu-loop.h"
 #include "accel/tcg/probe.h"
 #include "cpregs.h"
+#include "qemu/plugin.h"
+#include "exec/lcvex-difftest.h"
 
 #define SIGNBIT (uint32_t)0x80000000
 #define SIGNBIT64 ((uint64_t)1 << 63)
@@ -406,6 +408,12 @@ void HELPER(wfi)(CPUARMState *env, uint32_t insn_len)
     env->halt_reason = HALT_WFI;
     cs->exception_index = EXCP_HLT;
     cs->halted = 1;
+    /* TCG WFI exits directly from the helper before the generic CPU loop
+     * reaches qemu_process_cpu_events(). Notify the LCVEX plugin here so
+     * it can retire the pending WFI COMMIT without fabricating a PRE. */
+    if (qemu_lcvex_difftest_active()) {
+        qemu_plugin_vcpu_idle_cb(cs);
+    }
     cpu_loop_exit(cs);
 #endif
 }
@@ -637,6 +645,9 @@ void HELPER(wfe)(CPUARMState *env, uint32_t insn_len)
     env->halt_reason = HALT_WFE;
     cs->exception_index = EXCP_HLT;
     cs->halted = 1;
+    if (qemu_lcvex_difftest_active()) {
+        qemu_plugin_vcpu_idle_cb(cs);
+    }
     cpu_loop_exit(cs);
 #endif
 }
