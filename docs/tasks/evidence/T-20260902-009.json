  "scope": "诊断并修复 F1a 默认-on 下 9 个 Gate D 锁步失败：timer/RNDR off-by-one、ADC/SBC/NGC 进位前递、post-index load/store 基址与数据语义。",
  "root_causes": [
    {
      "name": "timer_rndr_off_by_one",
      "symptom": "CNTVCT/RNDR DUT 比 QEMU 小 1",
      "root": "MRS 读值仅用已提交 cntpct_r+1，遗漏 EX/MEM/MEM/WB 中尚未提交的更老指令",
      "fix": "EX 级 timer_ex_count 计入在途更老指令；timer/RNDR MRS 全部改用该计数"
    },
    {
      "name": "adc_sbc_ngc_carry",
      "symptom": "ngc x4,xzr 在 C=1 时 DUT=-1，QEMU=0",
      "root": "ALU cin 只接已提交 nzcv，未前递 EX/MEM/MEM/WB 的 set-flags 结果",
      "fix": "新增 nzcv_alu 从 exmem/memwb 前递进位，排除当前 set_flags 自环"
    },
    {
      "name": "post_index_wb3",
      "symptom": "ldrb w4,[x20],#-1 DUT 读 0xbb/基址 0x44090010，QEMU 读 0/基址 0x44090011",
      "root": "gprv 未前递 ID/EX 的 wb3 基址写回，紧邻 post-index 读到旧基址",
      "fix": "gprv 增加 idex_d.wb3_we/wb3_rd/wb3_extra 前递"
    }
  ],
