+/* P7 FP/NEON 单次状态快照。v[n] 是 Vn/Zn 的低端 little-endian 128 位，
+ * vector_bytes 是当前架构向量长度；upper_nonzero 表示未返回的高段存在
+ * 非零数据，调用方不得将其静默当作完整向量状态。 */
+#define QEMU_LCVEX_FP_STATE_DEFINED 1
+struct qemu_lcvex_fp_state {
+    uint32_t fpcr;
+    uint32_t fpsr;
+    uint32_t vector_bytes;
+    uint32_t upper_nonzero;
+    uint8_t v[32][16];
+};
+
+QEMU_PLUGIN_API
+int qemu_lcvex_difftest_read_fp_state(struct qemu_lcvex_fp_state *state);
