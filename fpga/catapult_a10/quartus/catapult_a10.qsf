# Catapult v3 / Arria 10 B0+ regenerable Quartus/Qsys skeleton constraints.
# Top-level entity: lcvex_catapult_a10_top (fpga/catapult_a10/rtl/).  The
# shell owns the physical board clocks, DDR4 EMIF pins, JTAG-UART and EPCQ
# Avalon boundaries plus the platform reset/calibration gate.  It contains no
# CPU, SoC interconnect or bridge implementation.
set_global_assignment -name TOP_LEVEL_ENTITY lcvex_catapult_a10_top
set_global_assignment -name FAMILY "Arria 10"
set_global_assignment -name DEVICE 10AX115N4F40E3SG
set_global_assignment -name STRATIXV_CONFIGURATION_SCHEME "ACTIVE SERIAL X4"
set_global_assignment -name ACTIVE_SERIAL_CLOCK FREQ_100MHZ
set_global_assignment -name SDC_FILE "catapult_a10.sdc"
set_global_assignment -name MIF_FILE "../boot/build/linux-loader/linux_loader.mif"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name VERILOG_MACRO SYNTHESIS
set_global_assignment -name LAST_QUARTUS_VERSION "21.4.0 Pro Edition"

# B0+ regenerable skeleton design files.
set_global_assignment -name SYSTEMVERILOG_FILE "../rtl/lcvex_catapult_a10_top.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../rtl/lcvex_catapult_a10_reset_gate.sv"

# B5-SoC/Boot: LCVEX core (P7 snapshot), B1-B4 cache/AXI chain and SoC top.
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_pkg.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_fp_state.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_fp_scalar.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_neon_fp.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_neon_int.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_regfile.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_alu.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_muldiv.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_mem_arb.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_l1_i.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_cache_data_ram.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_l1_d_wb.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_l2_wb.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_l2_probe.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_decode.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_mmu.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_core.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_axi4_pkg.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_axi4_avalon_pkg.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_async_fifo.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_calibration_gate.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_axi4_master.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_axi4_avalon_adapter.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_mem_router.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_catapult_soc_pkg.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_bram_boot.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_gic.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_catapult_soc_axi.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_catapult_soc_coh.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../rtl/lcvex_catapult_soc_top.sv"

# Regenerable DDR4 Qsys/IP inputs; Avalon-MM is platform-local only.
set_global_assignment -name QSYS_FILE "../qsys/ddr4_bot/Qsys.qsys"
set_global_assignment -name IP_FILE "../qsys/ddr4_bot/ip/Qsys/Qsys_clk_100.ip"
set_global_assignment -name IP_FILE "../qsys/ddr4_bot/ip/Qsys/Qsys_clk_266.ip"
set_global_assignment -name IP_FILE "../qsys/ddr4_bot/ip/Qsys/Qsys_emif_bot.ip"
set_global_assignment -name IP_FILE "../qsys/ddr4_bot/ip/Qsys/Qsys_reset_controller_0.ip"

# EPCQL1024 Active Serial x4 / SFL and Altera JTAG-UART are explicit inputs.
set_global_assignment -name QIP_FILE "../flash/sfl/sfl_sys.qip"
set_global_assignment -name VERILOG_FILE "../flash/sfl/ip/sfl_sys/clk/synth/clk.v"
set_global_assignment -name VERILOG_FILE "../flash/sfl/ip/sfl_sys/rst/synth/rst.v"
set_global_assignment -name VERILOG_FILE "../flash/sfl/ip/sfl_sys/epcq/synth/epcq.v"
set_global_assignment -name VERILOG_FILE "../flash/sfl/ip/sfl_sys/epcq/altera_asmi_parallel_1910/synth/epcq_altera_asmi_parallel_1910_rmd4qmi.v"
set_global_assignment -name VERILOG_FILE "../flash/sfl/ip/sfl_sys/epcq/altera_epcq_controller_191/synth/altera_asmi_parallel_epcq_epcq.v"
set_global_assignment -name VERILOG_FILE "../flash/sfl/ip/sfl_sys/epcq/altera_epcq_controller_191/synth/altera_epcq_controller_epcq_epcq.v"
set_global_assignment -name SYSTEMVERILOG_FILE "../flash/sfl/ip/sfl_sys/epcq/altera_epcq_controller_191/synth/epcq_altera_epcq_controller_191_yfexvhi.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../flash/sfl/ip/sfl_sys/epcq/altera_epcq_controller_core_1910/synth/altera_epcq_controller_arb.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../flash/sfl/ip/sfl_sys/epcq/altera_epcq_controller_core_1910/synth/altera_epcq_controller.sv"
set_global_assignment -name VERILOG_FILE "../jtag_uart/jtag_uart_std.v"
set_global_assignment -name VERILOG_FILE "../jtag_uart/jtag_uart_std_altera_avalon_jtag_uart_1910_zesttkq.v"

# Catapult clock and DDR4 pin assignments copied from the validated PoC.
set_location_assignment PIN_AP20 -to clk_u59
set_instance_assignment -name IO_STANDARD "1.8 V" -to clk_u59 -entity lcvex_catapult_a10_top
set_instance_assignment -name IO_STANDARD LVDS -to clk_y3 -entity lcvex_catapult_a10_top
set_location_assignment PIN_AG5 -to clk_y3
set_location_assignment PIN_AG6 -to "clk_y3(n)"
