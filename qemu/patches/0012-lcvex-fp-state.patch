+int qemu_lcvex_difftest_read_fp_state(struct qemu_lcvex_fp_state *state)
+{
+    CPUState *cs = current_cpu;
+    ARMCPU *cpu;
+    CPUARMState *env;
+    unsigned vq = 1;
+
+    if (state == NULL || cs == NULL || cs != qemu_get_cpu(0)) {
+        return -1;
+    }
+    cpu = ARM_CPU(cs);
+    env = &cpu->env;
+    if (!is_a64(env)) {
+        return -1;
+    }
+
+    memset(state, 0, sizeof(*state));
+    state->fpcr = vfp_get_fpcr(env);
+    state->fpsr = vfp_get_fpsr(env);
+
+    /* Without SVE the architectural register is exactly a 128-bit V/Q
+     * register. With SVE report the active VL, while the caller still only
+     * receives the low 128 bits and must reject non-zero high lanes. */
+    if (cpu_isar_feature(aa64_sve, cpu)) {
+        int active_vq = sve_vq(env);
+        if (active_vq < 1 || active_vq > arm_max_vq(cpu)) {
+            return -1;
+        }
+        vq = (unsigned)active_vq;
+    }
+    state->vector_bytes = vq * 16;
+
+    for (unsigned i = 0; i < 32; ++i) {
+        uint64_t *q = aa64_vfp_qreg(env, i);
+        stq_le_p(&state->v[i][0], q[0]);
+        stq_le_p(&state->v[i][8], q[1]);
+        for (unsigned lane = 1; lane < vq; ++lane) {
+            if (env->vfp.zregs[i].d[2 * lane] != 0 ||
+                env->vfp.zregs[i].d[2 * lane + 1] != 0) {
+                state->upper_nonzero = 1;
+            }
+        }
+    }
+    return 0;
+}
