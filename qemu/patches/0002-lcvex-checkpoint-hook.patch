                                        uint32_t *ec, uint32_t *esr,
                                        uint64_t *far);
 
+/* 在当前单指令 vCPU 回调上下文保存 CPU/设备 vmstate；仅供 LCVEX
+ * CKPT_REQ 协议使用，返回 0 表示成功。 */
+QEMU_PLUGIN_API
+int qemu_lcvex_difftest_save_devices_state(const char *path,
+                                           const char *sys_path,
+                                           const char *timer_path,
+                                           const char *gic_path);
+
+/* 联合 checkpoint 恢复时，在第一条 guest 指令前校正 QEMU 虚拟计数基准；
+ * 仅当调用方设置 LCVEX_TIMER_RESTORE_PATH 时由插件使用。 */
+QEMU_PLUGIN_API
+int qemu_lcvex_difftest_restore_timer_state(const char *path);
+
 /** struct qemu_plugin_tb - Opaque handle for a translation block */
 struct qemu_plugin_tb;
 /** struct qemu_plugin_insn - Opaque handle for a translated instruction */
diff --git a/target/arm/helper.c b/target/arm/helper.c
index b1a3d31..545161a 100644
--- a/target/arm/helper.c
+++ b/target/arm/helper.c
@@ -1356,7 +1356,8 @@ uint64_t gt_get_countervalue(CPUARMState *env)
 {
     ARMCPU *cpu = env_archcpu(env);
 
-    return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / gt_cntfrq_period_ns(cpu);
