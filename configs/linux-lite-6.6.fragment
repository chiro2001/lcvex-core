# LCVEX Linux 6.6 lite：只保留单核、AArch64、virt/GICv2、PL011、Generic
# Timer 和 initramfs 所需的最小内核功能。最终 .config 仍以 Kconfig 依赖
# 求解结果为准；本文件是可审阅的输入边界，不手工伪造依赖项。
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_MMU=y
CONFIG_ARM64_PAGE_SHIFT=12
# Linux 6.6 arm64 将 SMP 定义为架构强制项；运行时由单核 DT 限制为 CPU0。
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_ARM_GIC=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_SERIAL_AMBA=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_TTY=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_ARM64_USE_LSE_ATOMICS=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y

# 不在 lite 线引入外设/特权扩展；这些功能仍由主线逐步验证。
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_PCI is not set
# CONFIG_VIRTIO is not set
# CONFIG_EFI is not set
# CONFIG_ACPI is not set
# CONFIG_KVM is not set
# CONFIG_ARM64_SVE is not set
# CONFIG_ARM64_SME is not set
# CONFIG_ARM64_PTR_AUTH is not set
# CONFIG_ARM64_MTE is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_DEBUG_INFO is not set
